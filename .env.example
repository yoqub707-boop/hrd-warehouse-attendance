# HRD Omborxona Davomat Tizimi - Konfiguratsiya Namunasi
APP_NAME="HRD Omborxona Davomat Tizimi"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent

# Ma'lumotlar bazasi (mysql yoki sqlite)
DB_CONNECTION=mysql
DB_FILE=database/warehouse.sqlite

# MySQL konfiguratsiyasi
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrd_warehouse
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

# Telegram Bot API sozlamalari
TELEGRAM_BOT_ENABLE=true
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"

# Terminal sozlamalari
TERMINAL_NAME="1-Ombor Asosiy Kirish Nuqtasi"
ALLOW_MANUAL_ATTENDANCE=true
CAMERA_FALLBACK=true
